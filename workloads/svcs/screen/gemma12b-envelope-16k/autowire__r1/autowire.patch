@@ -0,0 +1,137 @@
+import inspect
+from dataclasses import InitVar
+from contextlib import contextmanager, asynccontextmanager
+from typing import Any, Callable, Type, get_type_hints
+from ._core import Container
+
+def autowire(fn_or_cls: Callable) -> Callable[[Container], Any]:
+    """
+    Returns a factory that resolves each of `fn_or_cls`'s annotated parameters 
+    from the provided `svcs.Container`.
+
+    It is meant to replace hand-written factories that do nothing but pull each 
+    dependency out of the container:
+
+    ```python
+    registry.register_factory(Handler, autowire(Handler))
+    ```
+
+    Each annotated parameter is resolved from the container by its annotation.
+    A parameter annotated as `svcs.Container` receives the container itself 
+    rather than a looked-up service.
+
+    If a service is not registered and that parameter has a default value, the 
+    default is used instead of raising. This applies only when the *missing* 
+    service is the parameter's own annotation — if resolving a parameter fails 
+    because something it depends on is missing, that failure propagates rather 
+    than being masked by the default.
+
+    Variadic parameters (`*args`, `**kwargs`) are ignored.
+    `dataclasses.InitVar` annotations are unwrapped to the type they wrap.
+    A required parameter with neither an annotation nor a default is an error: 
+    raise `TypeError`.
+    String annotations — as produced by `from __future__ import annotations`, or 
+    written as forward references — resolve to the same services as the 
+    equivalent non-string annotations. Resolution must tolerate a name that is 
+    not resolvable at decoration time but is by the time the factory runs.
+    Factories that return context managers are entered and cleaned up as usual.
+    A bare generator function is rejected with `TypeError`, because its cleanup 
+    would be silently lost; a callable decorated with `contextlib.contextmanager` 
+    is fine.
+    """
+    sig = inspect.signature(fn_or_cls)
+    hints = get_type_hints(fn_or_cls)
+
+    if inspect.isgeneratorfunction(fn_or_cls) and not hasattr(fn_or_cls, "__contextmanager__"):
+        raise TypeError("Bare generator functions are not supported; use @contextmanager.")
+
+    def factory(container: Container) -> Any:
+        args = []
+        kwargs = {}
+        for name, param in sig.parameters.items():
+            if param.kind in (param.VAR_POSITIONAL, param.VAR_KEYWORD):
+                continue
+            
+            annotation = hints.get(name, param.annotation)
+            
+            if annotation is InitVar:
+                pass
+            elif hasattr(annotation, "__origin__") and annotation.__origin__ is InitVar:
+                annotation = annotation.__args__[0]
+
+            if annotation is Container or annotation == "Container" or annotation == "svcs.Container":
+                args.append(container)
+                continue
+
+            if annotation is inspect.Parameter.empty:
+                if param.default is inspect.Parameter.empty:
+                    raise TypeError(f"Missing required parameter: {name}")
+                args.append(param.default)
+                continue
+
+            try:
+                svc = container.get(annotation)
+                args.append(svc)
+            except Exception:
+                if param.default is not inspect.Parameter.empty:
+                    args.append(param.default)
+                else:
+                    raise
+                    
+        return fn_or_cls(*args, **kwargs)
+
+    return factory
+
+async def aautowire(fn_or_cls: Callable) -> Callable[[Container], Any]:
+    """
+    The asynchronous counterpart to `autowire`. It resolves services through the 
+    container's asynchronous lookup, returns an async factory, and awaits the 
+    result of `fn_or_cls` when that result is awaitable. It also works with 
+    synchronous callables and synchronous services, so an async application can 
+    use it throughout.
+    """
+    sig = inspect.signature(fn_or_cls)
+    hints = get_type_hints(fn_or_cls)
+
+    if inspect.isgeneratorfunction(fn_or_cls) and not hasattr(fn_or_cls, "__contextmanager__"):
+        raise TypeError("Bare generator functions are not supported; use @contextmanager.")
+
+    async def factory(container: Container) -> Any:
+        args = []
+        kwargs = {}
+        for name, param in sig.parameters.items():
+            if param.kind in (param.VAR_POSITIONAL, param.VAR_KEYWORD):
+                continue
+            
+            annotation = hints.get(name, param.annotation)
+            
+            if annotation is InitVar:
+                pass
+            elif hasattr(annotation, "__origin__") and annotation.__origin__ is InitVar:
+                annotation = annotation.__args__[0]
+
+            if annotation is Container or annotation == "Container" or annotation == "svcs.Container":
+                args.append(container)
+                continue
+
+            if annotation is inspect.Parameter.empty:
+                if param.default is inspect.Parameter.empty:
+                    raise TypeError(f"Missing required parameter: {name}")
+                args.append(param.default)
+                continue
+
+            try:
+                svc = await container.aget(annotation)
+                args.append(svc)
+            except Exception:
+                if param.default is not inspect.Parameter.empty:
+                    args.append(param.default)
+                else:
+                    raise
+                    
+        res = fn_or_cls(*args, **kwargs)
+        if inspect.isawaitable(res):
+            return await res
+        return res
+
+    return factory
