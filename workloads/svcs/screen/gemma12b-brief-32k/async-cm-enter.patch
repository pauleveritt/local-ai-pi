+import inspect
+from contextlib import asynccontextmanager, AbstractAsyncContextManager
+import asyncio
+
+@asynccontextmanager
+async def context():
+    yield 1
+
+cm = context()
+print(f"IsAbstractAsyncContextManager: {isinstance(cm, AbstractAsyncContextManager)}")
+print(f"IsAwaitable: {inspect.isawaitable(cm)}")
