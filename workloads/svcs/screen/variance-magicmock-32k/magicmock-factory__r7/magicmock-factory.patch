@@ -0,0 +1,41 @@
+import pytest
+from unittest.mock import MagicMock, AsyncMock
+from contextlib import contextmanager
+from svcs import Registry, Container
+
+def mock_factory():
+    return MagicMock()
+
+def async_mock_factory():
+    return AsyncMock()
+
+def test_magic_mock_get():
+    reg = Registry()
+    reg.register_factory("MockType", mock_factory)
+    con = Container(reg)
+    
+    # This is expected to fail with TypeError: Use `aget()` for async factories.
+    # because MagicMock is an instance of AbstractAsyncContextManager.
+    with pytest.raises(TypeError) as excinfo:
+         con.get("MockType")
+    assert "Use `aget()` for async factories." in str(excinfo.value)
+
+@pytest.mark.asyncio
+async def test_async_mock_aget():
+    reg = Registry()
+    reg.register_factory("AsyncMockType", async_mock_factory)
+    con = Container(reg)
+    
+    # This should work.
+    svc = await con.aget("AsyncMockType")
+    assert isinstance(svc, AsyncMock)
+
+@pytest.mark.asyncio
+async def test_magic_mock_aget():
+    reg = Registry()
+    reg.register_factory("MagicMockType", mock_factory)
+    con = Container(reg)
+    
+    # This should also work if it's a MagicMock.
+    svc = await con.aget("MagicMockType")
+    assert isinstance(svc, MagicMock)
