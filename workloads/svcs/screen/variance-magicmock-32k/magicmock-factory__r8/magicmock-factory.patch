+# SPDX-FileCopyrightText: 2023 Hynek Schlawack <hs@ox.cx>
+#
+# SPDX-License-Identifier: MIT
+
+import pytest
+from unittest.mock import MagicMock, AsyncMock
+import svcs
+from svcs._core import Container, Registry
+from .ifaces import Service
+
+def test_mock_factory_get():
+    registry = Registry()
+    # Mock that behaves like a context manager
+    mock_svc = MagicMock()
+    registry.register_factory(Service, lambda: mock_svc)
+    
+    container = Container(registry)
+    # This should return mock_svc without trying to enter it
+    svc = container.get(Service)
+    assert svc == mock_svc
+    assert mock_svc.__enter__.call_count == 0
+
+@pytest.mark.asyncio
+async def test_mock_factory_aget():
+    registry = Registry()
+    # Mock that behaves like an awaitable
+    mock_svc = AsyncMock()
+    registry.register_factory(Service, lambda: mock_svc)
+    
+    container = Container(registry)
+    # This should return mock_svc without trying to await it
+    svc = await container.aget(Service)
+    assert svc == mock_svc
+    assert mock_svc.__aenter__.call_count == 0
