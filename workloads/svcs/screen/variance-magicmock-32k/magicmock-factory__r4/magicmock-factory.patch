--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,63 @@
+import asyncio
+import sys
+import os
+
+# Add the current directory to sys.path so we can import svcs
+sys.path.insert(0, os.getcwd())
+
+from unittest.mock import MagicMock, AsyncMock
+from contextlib import AbstractContextManager
+from inspect import isawaitable, iscoroutine
+from typing import Any
+
+try:
+    from svcs._core import Container, Registry, RegisteredService
+    print(f"svcs loaded from: {__import__('svcs').__file__}")
+except ImportError as e:
+    print(f"Import failed: {e}")
+    sys.exit(1)
+
+class MockSvc:
+    pass
+
+class AsyncMockSvc:
+    pass
+
+async def main():
+    registry = Registry()
+    container = Container(registry)
+
+    # Test 1: MagicMock in get()
+    # MagicMock should not be treated as a context manager or coroutine.
+    mock_svc = MagicMock()
+    print(f"isinstance(MagicMock, AbstractContextManager): {isinstance(mock_svc, AbstractContextManager)}")
+    print(f"iscoroutine(MagicMock): {iscoroutine(mock_svc)}")
+    print(f"hasattr(MagicMock, '_mock'): {hasattr(mock_svc, '_mock')}")
+    registry.register_value(MockSvc, mock_svc)
+    
+    try:
+        svc = container.get(MockSvc)
+        print("get() with MagicMock success")
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
+        print(f"get() with MagicMock failed: {e}")
+
+    # Test 2: AsyncMock in aget()
+    # AsyncMock is awaitable.
+    mock_async_svc = AsyncMock()
+    print(f"isinstance(AsyncMock, AbstractContextManager): {isinstance(mock_async_svc, AbstractContextManager)}")
+    print(f"isawaitable(AsyncMock): {isawaitable(mock_async_svc)}")
+    print(f"hasattr(AsyncMock, '_mock'): {hasattr(mock_async_svc, '_mock')}")
+    registry.register_value(AsyncMockSvc, mock_async_svc)
+    
+    try:
+        svc = await container.aget(AsyncMockSvc)
+        print("aget() with AsyncMock success")
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
+        print(f"aget() with AsyncMock failed: {e}")
+
+if __name__ == "__main__":
+    asyncio.run(main())
