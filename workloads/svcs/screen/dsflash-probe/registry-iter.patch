diff --git a/tests/test_registry.py b/tests/test_registry.py
index bc6d01c..82c626e 100644
--- a/tests/test_registry.py
+++ b/tests/test_registry.py
@@ -281,6 +281,31 @@ class TestRegistry:
         assert Service in registry
         assert AnotherService not in registry
 
+    def test_iter_empty(self, registry):
+        """
+        Iterating an empty registry yields nothing.
+        """
+        assert [] == list(registry)
+
+    def test_iter_yields_registered_services(self, registry):
+        """
+        Iterating a registry yields the RegisteredService instances it stores
+        for each registered type.
+        """
+        registry.register_factory(Service, Service)
+        registry.register_factory(AnotherService, AnotherService)
+
+        services = list(registry)
+
+        assert services == [
+            registry.get_registered_service_for(Service),
+            registry.get_registered_service_for(AnotherService),
+        ]
+
+        # Iterating works with `for` loops, too.
+        for service in registry:
+            assert service in services
+
