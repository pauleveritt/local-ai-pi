+    def __iter__(self) -> Iterator[RegisteredService]:
+        """
+        Iterate over the registered services.
+
+        Iterating yields the :class:`RegisteredService` instances that the
+        registry stores for each registered type:
+
+        .. doctest::
+
+            >>> reg = svcs.Registry()
+            >>> reg.register_value(int, 42)
+            >>> list(reg)[0].svc_type
+            <class 'int'>
+            >>> for rs in reg:
+            ...     rs.svc_type
+            <class 'int'>
+        """
+        return iter(self._services.values())
+
     def __enter__(self) -> Registry:
