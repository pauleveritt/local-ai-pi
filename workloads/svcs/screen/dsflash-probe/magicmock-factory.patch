+    def test_get_mock_factory(self, registry, container):
+        """
+        A factory returning a MagicMock is resolved as a plain value: get()
+        returns the mock without entering it as a context manager or
+        registering a cleanup.
+        """
+        factory = MagicMock()
+        registry.register_factory(int, factory)
+
+        svc = container.get(int)
+
+        assert svc is factory.return_value
+        assert int in container
+        assert not container._on_close
+
+        container.close()
+
+        assert not container._on_close
+
+    @pytest.mark.asyncio
+    async def test_aget_mock_factory(self, registry, container):
+        """
+        aget() with a synchronous MagicMock factory returns the mock without
+        entering it as a context manager or registering a cleanup.
+        """
+        factory = MagicMock()
+        registry.register_factory(int, factory)
+
+        svc = await container.aget(int)
+
+        assert svc is factory.return_value
+        assert int in container
+        assert not container._on_close
+
+        await container.aclose()
+
+        assert not container._on_close
+
+    @pytest.mark.asyncio
+    async def test_aget_async_mock_factory(self, registry, container):
+        """
+        aget() with an AsyncMock-based factory returns the mock it produces
+        without entering it as a context manager or registering a cleanup.
+        """
+        factory = AsyncMock()
+        registry.register_factory(int, factory)
+
+        svc = await container.aget(int)
+
+        assert isinstance(svc, Mock)
+        assert int in container
+        assert not container._on_close
+
+        await container.aclose()
+
+        assert not container._on_close
+
+    @pytest.mark.asyncio
