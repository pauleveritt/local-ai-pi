+def _is_mock(obj: object) -> bool:
+    """
+    Return True if *obj* is an :mod:`unittest.mock` instance.
+
+    A mock answers *any* attribute access with another mock, which means
+    checks like "is this a context manager?" or "is this awaitable?" wrongly
+    answer yes for a mock that is neither. We therefore treat mocks as plain
+    values instead of entering or awaiting them.
+    """
+    return isinstance(obj, unittest.mock.Base)
+
