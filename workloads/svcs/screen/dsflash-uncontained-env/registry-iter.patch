+    def test_iter(self, registry):
+        """
+        Iterating a registry yields the registered services.
+        """
+        registry.register_factory(Service, Service)
+        registry.register_value(AnotherService, AnotherService())
+
+        services = list(registry)
+
+        assert registry.get_registered_service_for(Service) == services[0]
+        assert registry.get_registered_service_for(AnotherService) == services[1]
+
+        # `for service in registry:` works, too.
+        seen = {service.svc_type for service in registry}
+        assert seen == {Service, AnotherService}
