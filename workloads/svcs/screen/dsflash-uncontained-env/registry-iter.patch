+    def __iter__(self):
+        """
+        Yield the :class:`RegisteredService` instances for every registered
+        service type.
+
+        .. doctest::
+
+            >>> reg = svcs.Registry()
+            >>> reg.register_value(int, 42)
+            >>> reg.register_value(str, "Hello World")
+            >>> list(reg)
+            [<RegisteredService(svc_type=builtins.int, factory=<function <lambda> at 0x...>, takes_container=False, enter=False, has_ping=False)>, ...]
+        """
+        return iter(self._services.values())
+
     def __enter__(self) -> Registry:
         return self
 
