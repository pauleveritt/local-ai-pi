+def get_registry(app: AppLike) -> svcs.Registry:
+    """
+    Get the :class:`svcs.Registry` from a running FastAPI application.
+
+    This allows access to the registry outside of request scope, for example
+    in tests or startup hooks.
+
+    Args:
+        app: A :class:`fastapi.FastAPI` application or a
+           :class:`fastapi.testclient.TestClient`.
+
+    Returns:
+        The :class:`svcs.Registry` that the lifespan attached to the app.
+
+    Raises:
+        RuntimeError:
+            If the application has no :class:`svcs.fastapi.lifespan`
+            attached, or if the lifespan is not currently active (i.e., the
+            app has not started or has already shut down).
+
+    Example:
+        >>> from fastapi import FastAPI
+        >>> from fastapi.testclient import TestClient
+        >>> import svcs
+        ...
+        >>> @svcs.fastapi.lifespan
+        ... async def lifespan(app: FastAPI, registry: svcs.Registry):
+        ...     registry.register_value(int, 42)
+        ...     yield
+        ...
+        >>> app = FastAPI(lifespan=lifespan)
+        >>> with TestClient(app) as client:
+        ...     reg = svcs.fastapi.get_registry(client)
+        ...     assert int in reg
+    """
+    # Extract app from TestClient if needed
+    if isinstance(app, TestClient):
+        app = app.app
+
+    if not isinstance(app, FastAPI):
+        msg = (
+            "app must be a FastAPI application or a TestClient, "
+            f"got {type(app).__name__!r}"
+        )
+        raise TypeError(msg)
+
+    # Walk through the router chain to find the svcs lifespan
+    router: Router = app.router
+    while True:
+        lc = getattr(router, "lifespan_context", None)
+        if isinstance(lc, lifespan):
+            if not lc._active:
+                msg = (
+                    "The application's svcs lifespan is not currently active. "
+                    "Ensure the app is running (e.g. inside a TestClient "
+                    "context) and has not shut down."
+                )
+                raise RuntimeError(msg)
+            return lc.registry
+
+        # Check if there's a mounted router to recurse into
+        sub_router: Router | None = None
+        for route in getattr(router, "routes", []):
+            if (
+                hasattr(route, "app")
+                and isinstance(route.app, Router)
+                and route.app is not router
+            ):
+                sub_router = route.app
+                break
+
+        if sub_router is None:
+            break
+        router = sub_router
+
+    msg = (
+        "No svcs registry found. "
+        "Ensure the application uses svcs.fastapi.lifespan."
+    )
+    raise RuntimeError(msg)
 
 
