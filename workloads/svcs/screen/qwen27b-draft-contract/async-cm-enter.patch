+    @pytest.mark.asyncio
+    async def test_aget_enters_sync_cm_from_async_factory(self, container):
+        """
+        If an async factory returns a synchronous context manager, aget
+        enters it and registers its cleanup.
+        """
+        is_closed = False
+
+        @contextmanager
+        def make_cm():
+            yield 42
+            nonlocal is_closed
+            is_closed = True
+
+        async def factory():
+            return make_cm()
+
+        container.registry.register_factory(int, factory)
+
+        async with container:
+            assert 42 == await container.aget(int)
+
+        assert is_closed
+
+    @pytest.mark.asyncio
+    async def test_aget_enters_async_cm_from_async_factory(self, container):
+        """
+        If an async factory returns an async context manager, aget
+        enters it and registers its cleanup.
+        """
+        is_closed = False
+
+        @asynccontextmanager
+        async def make_cm():
+            yield 42
+            nonlocal is_closed
+            is_closed = True
+
+        async def factory():
+            return await make_cm().__aenter__()  # No, we want to return the CM itself
+
+        # Correction: factory should return the async context manager object
+        async def factory2():
+            return make_cm()  # make_cm() returns AbstractAsyncContextManager
+
+        container.registry.register_factory(int, factory2)
+
+        async with container:
+            assert 42 == await container.aget(int)
+
+        assert is_closed
