+def autowire(fn_or_cls: Callable) -> Callable[[Container], Any]:
+    """
+    Return a **synchronous factory** that resolves *fn_or_cls*'s annotated
+    parameters from a :class:`Container` at call time.
+
+    Each annotated parameter is looked up from the container by its
+    annotation. A parameter annotated as :class:`Container` receives the
+    container itself. If a service is not found and the parameter has a
+    default value, the default is used instead.
+
+    Raises:
+        TypeError:
+            If *fn_or_cls* is a bare generator function, or if a required
+            parameter has neither an annotation nor a default value.
+
+    Example::
+
+        registry.register_factory(Handler, autowire(Handler))
+    """
+    if isgeneratorfunction(fn_or_cls):
+        raise TypeError(
+            f"{fn_or_cls.__qualname__!r} is a bare generator function; "
+            "autowire cannot use it because its cleanup would be silently lost. "
+            "Use contextlib.contextmanager or a class with __enter__/__exit__ instead."
+        )
+
+    sig = _robust_signature(fn_or_cls)
+    if sig is None:
+        raise TypeError(
+            f"Could not inspect signature of {fn_or_cls!r}"
+        )
+
+    # Pre-compute the parameter resolution plan at decoration time.
+    params: list[tuple[str, Any, inspect.Parameter]] = []
+    for name, param in sig.parameters.items():
+        if param.kind in (
+            inspect.Parameter.VAR_POSITIONAL,
+            inspect.Parameter.VAR_KEYWORD,
+        ):
+            continue
+
+        annotation = param.annotation
+        if annotation is inspect.Parameter.empty:
+            if param.default is inspect.Parameter.empty:
+                raise TypeError(
+                    f"Parameter {name!r} of {fn_or_cls.__qualname__!r} "
+                    "has no annotation and no default"
+                )
+            # Unannotated with default — skip; value comes from default
+            continue
+
+        resolved_annotation = _unwrap_init_var(annotation)
+        params.append((name, resolved_annotation, param))
+
+    def factory(container: Container) -> Any:
+        args: list[Any] = []
+        for name, resolved_annotation, param in params:
+            if resolved_annotation is Container:
+                args.append(container)
+            else:
+                try:
+                    args.append(container.get(resolved_annotation))
+                except ServiceNotFoundError:
+                    if param.default is not inspect.Parameter.empty:
+                        args.append(param.default)
+                    else:
+                        raise
+        return fn_or_cls(*args)
+
+    return factory
+
+
+def aautowire(fn_or_cls: Callable) -> Callable[[Container], Awaitable[Any]]:
+    """
+    Return an **async factory** that resolves *fn_or_cls*'s annotated
+    parameters from a :class:`Container` at call time.
+
+    Like :func:`autowire` but uses :meth:`Container.aget` for lookups and
+    awaits the result of *fn_or_cls* if it is awaitable.
+
+    Works with both synchronous and asynchronous callables.
+
+    Raises:
+        TypeError:
+            If a required parameter has neither an annotation nor a default
+            value.
+    """
+    sig = _robust_signature(fn_or_cls)
+    if sig is None:
+        raise TypeError(
+            f"Could not inspect signature of {fn_or_cls!r}"
+        )
+
+    params: list[tuple[str, Any, inspect.Parameter]] = []
+    for name, param in sig.parameters.items():
+        if param.kind in (
+            inspect.Parameter.VAR_POSITIONAL,
+            inspect.Parameter.VAR_KEYWORD,
+        ):
+            continue
+
+        annotation = param.annotation
+        if annotation is inspect.Parameter.empty:
+            if param.default is inspect.Parameter.empty:
+                raise TypeError(
+                    f"Parameter {name!r} of {fn_or_cls.__qualname__!r} "
+                    "has no annotation and no default"
+                )
+            continue
+
+        resolved_annotation = _unwrap_init_var(annotation)
+        params.append((name, resolved_annotation, param))
+
+    async def factory(container: Container) -> Any:
+        args: list[Any] = []
+        for name, resolved_annotation, param in params:
+            if resolved_annotation is Container:
+                args.append(container)
+            else:
+                try:
+                    args.append(await container.aget(resolved_annotation))
+                except ServiceNotFoundError:
+                    if param.default is not inspect.Parameter.empty:
+                        args.append(param.default)
+                    else:
+                        raise
+        result = fn_or_cls(*args)
+        if isawaitable(result):
+            return await result
+        return result
+
+    return factory
+
+
