+def _unwrap_init_var(annotation: Any) -> Any:
+    """
+    Unwrap ``dataclasses.InitVar[X]`` to ``X``.
+
+    Handles both older Python (where InitVar[X] is a generic alias with
+    ``__origin__``) and Python 3.14+ (where InitVar[X] is an instance of
+    the ``InitVar`` class with a ``.type`` attribute).
+    """
+    # Python 3.14+: InitVar[X] is an instance of the InitVar class
+    if type(annotation) is dataclasses.InitVar:
+        return annotation.type  # pyright: ignore[reportAttributeAccessIssue]
+    # Older Python: InitVar[X] is a _GenericAlias
+    if (
+        hasattr(annotation, "__origin__")
+        and annotation.__origin__ is dataclasses.InitVar
+    ):
+        return annotation.__args__[0]
+    return annotation
+
