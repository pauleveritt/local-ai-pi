diff --git a/tests/test_container_pings.py b/tests/test_container_pings.py
new file mode 100644
index 0000000..3a41128
--- /dev/null
+++ b/tests/test_container_pings.py
@@ -0,0 +1,49 @@
+import pytest
+from svcs import Registry, Container
+from typing import Any
+
+def test_get_pings_registry_only():
+    reg = Registry()
+    reg.register_factory(int, lambda: 42, ping=lambda x: print(f"pinging {x}"))
+    con = Container(reg)
+    pings = con.get_pings()
+    assert len(pings) == 1
+    assert pings[0]._svc_type == int
+
+def test_get_pings_local_registration():
+    reg = Registry()
+    reg.register_factory(int, lambda: 42, ping=lambda x: print("registry ping"))
+    
+    con = Container(reg)
+    con.register_local_factory(int, lambda: 43, ping=lambda x: print("local ping"))
+    
+    pings = con.get_pings()
+    assert len(pings) == 1
+    # Should be the local one
+    assert pings[0]._ping != (lambda x: print("registry ping"))
+
+def test_get_pings_local_shadows_no_ping():
+    reg = Registry()
+    reg.register_factory(int, lambda: 42, ping=lambda x: print("registry ping"))
+    
+    con = Container(reg)
+    # Local registration for same type, but NO ping
+    con.register_local_factory(int, lambda: 43, ping=None)
+    
+    pings = con.get_pings()
+    assert len(pings) == 0
+
+def test_get_pings_multiple_types():
+    reg = Registry()
+    reg.register_factory(int, lambda: 42, ping=lambda x: None)
+    reg.register_factory(str, lambda: "s", ping=lambda x: None)
+    
+    con = Container(reg)
+    con.register_local_factory(int, lambda: 43, ping=lambda x: None)
+    
+    pings = con.get_pings()
+    assert len(pings) == 2
+    types = [p._svc_type for p in pings]
+    assert int in types
+    assert str in types
+
