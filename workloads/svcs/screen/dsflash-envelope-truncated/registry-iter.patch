+    def __iter__(self) -> Iterator[RegisteredService]:
+        """
+        Yield the registered services -- the same objects the registry stores
+        for each registered type.
+
+        .. doctest::
+
+            >>> reg = svcs.Registry()
+            >>> reg.register_value(int, 42)
+            >>> reg.register_value(str, "Hello")
+            >>> list(reg)
+            [<RegisteredService(svc_type=int, ...)>, <RegisteredService(svc_type=str, ...)>]
+            >>> for rs in reg:
