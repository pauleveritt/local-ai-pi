+import unittest.mock
+import asyncio
+from svcs._core import Container, Registry
+
+class MockSvc:
+    pass
+
+MockSvcSync = type("MockSvcSync", (), {})
+
+def test_mock_factory():
+    reg = Registry()
+    # Mock factory that returns an AsyncMock
+    mock_svc = unittest.mock.AsyncMock()
+    reg.register_factory(MockSvc, lambda: mock_svc)
+    
+    container = Container(reg)
+    
+    print("Testing container.get() with AsyncMock...")
+    print(f"Mock object: {mock_svc}")
+    print(f"Attributes of mock_svc: {dir(mock_svc)}")
+    
+    try:
+        svc = container.get(MockSvc)
+        print(f"get() result: {svc}")
+        assert svc == mock_svc
+    except Exception as e:
+        print(f"get() raised: {type(e).__name__}: {e}")
+        import traceback
+        traceback.print_exc()
+        return
+
+    print("\nTesting container.aget() with AsyncMock...")
+    try:
+        svc = container.aget(MockSvc)
+        print(f"aget() result: {svc}")
+        assert svc == mock_svc
+    except Exception as e:
+        print(f"aget() raised: {type(e).__name__}: {e}")
+        import traceback
+        traceback.print_exc()
+        return
+
+    print("\nTesting container.get() with MagicMock...")
+    mock_svc_sync = unittest.mock.MagicMock()
+    reg.register_factory(MockSvcSync, lambda: mock_svc_sync)
+    
+    container_sync = Container(reg)
+    
+    try:
+        svc = container_sync.get(MockSvcSync)
+        print(f"get() result: {svc}")
+        assert svc == mock_svc_sync
+    except Exception as e:
+        print(f"get() raised: {type(e).__name__}: {e}")
+        import traceback
+        traceback.print_exc()
+        return
+
+    print("\nTesting container.aget() with MagicMock...")
+    try:
+        svc = container_sync.aget(MockSvcSync)
+        print(f"aget() result: {svc}")
+        assert svc == mock_svc_sync
+    except Exception as e:
+        print(f"aget() raised: {type(e).__name__}: {e}")
+        import traceback
+        traceback.print_exc()
+        return
+
+    print("\nSuccess!")
+
+if __name__ == "__main__":
+    test_mock_factory()
