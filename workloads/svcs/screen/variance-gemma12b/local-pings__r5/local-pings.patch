@@ -0,0 +1,77 @@
+# SPDX-FileCopyrightText: 2023 Hynek Schlawack <hs@ox.cx>
+#
+# SPDX-License-Identifier: MIT
+
+import pytest
+from unittest.mock import Mock
+import svcs
+from .ifaces import Service, AnotherService
+
+def test_get_pings_with_local_registrations(registry, container):
+    """
+    Test that local registrations are included in get_pings and correctly
+    shadow registry registrations.
+    """
+    # 1. Registry service with ping
+    registry.register_factory(Service, lambda: Service(), ping=Mock())
+    
+    # 2. Local service with ping
+    container.register_local_factory(AnotherService, lambda: AnotherService(), ping=Mock())
+
+    pings = container.get_pings()
+    
+    # Should have both
+    assert len(pings) == 2
+    assert any(p._svc_type == Service for p in pings)
+    assert any(p._svc_type == AnotherService for p in pings)
+
+def test_get_pings_shadowing_behavior(registry, container):
+    """
+    Test shadowing rules for local registrations.
+    """
+    # 3. Local service WITHOUT ping
+    # This should not be reported, and should shadow a registry service with ping.
+    registry.register_factory(Service, lambda: Service(), ping=Mock())
+    container.register_local_factory(Service, lambda: Service(), ping=None)
+    
+    pings = container.get_pings()
+    
+    # Should be empty because local Service has no ping
+    assert len(pings) == 0
+
+def test_get_pings_local_shadows_registry_with_ping(registry, container):
+    """
+    Test that local registration with ping shadows registry registration.
+    """
+    # 4. Local service WITH ping shadows registry service (no ping)
+    registry.register_factory(Service, lambda: Service(), ping=None)
+    container.register_local_factory(Service, lambda: Service(), ping=Mock())
+
+    pings = container.get_pings()
+    
+    # Should have 1 ping (from local)
+    assert len(pings) == 1
+    assert pings[0]._svc_type == Service
+
+def test_get_pings_no_change_for_registry_only(registry, container):
+    """
+    Ensure behavior for types with only a registry registration doesn't change.
+    """
+    # 5. Registry only with ping
+    registry.register_factory(Service, lambda: Service(), ping=Mock())
+    
+    pings = container.get_pings()
+    
+    assert len(pings) == 1
+    assert pings[0]._svc_type == Service
+
+def test_get_pings_no_change_for_no_ping_anywhere(registry, container):
+    """
+    Ensure behavior for services that declare no ping anywhere doesn't change.
+    """
+    # 6. Registry only, no ping
+    registry.register_factory(Service, lambda: Service(), ping=None)
+    
+    pings = container.get_pings()
+    
+    assert len(pings) == 0
