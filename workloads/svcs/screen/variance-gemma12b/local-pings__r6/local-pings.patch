+import pytest
+from svcs import Registry, Container
+from typing import Callable
+
+def test_get_pings_local_registration():
+    registry = Registry()
+    container = Container(registry)
+
+    # Register a service with a ping in the registry
+    registry.register_factory(int, lambda: 1, ping=lambda x: None)
+
+    # Verify it is reported
+    assert len(container.get_pings()) == 1
+
+    # Register a local service of the same type WITHOUT a ping
+    # This should shadow the registry registration, and since it has no ping,
+    # no ping should be reported for 'int'.
+    container.register_local_factory(int, lambda: 2, ping=None)
+
+    assert len(container.get_pings()) == 0
+
+def test_get_pings_local_shadowing_with_ping():
+    registry = Registry()
+    container = Container(registry)
+
+    # Registry registration with ping
+    registry.register_factory(str, lambda: "reg", ping=lambda x: None)
+
+    # Local registration with a different ping
+    container.register_local_factory(str, lambda: "loc", ping=lambda x: None)
+
+    pings = container.get_pings()
+    assert len(pings) == 1
+    assert pings[0]._svc_type is str
+
+def test_get_pings_only_registry():
+    registry = Registry()
+    container = Container(registry)
+
+    registry.register_factory(float, lambda: 1.0, ping=lambda x: None)
+
+    assert len(container.get_pings()) == 1
+
+def test_get_pings_no_ping_anywhere():
+    registry = Registry()
+    container = Container(registry)
+
+    registry.register_factory(bool, lambda: True, ping=None)
+
+    assert len(container.get_pings()) == 0
