+++ b/tests/test_container_pings.py
@@ -0,0 +1,84 @@
+import unittest
+from typing import Any
+from svcs._core import Container, Registry, RegisteredService, ServicePing
+
+class MockService:
+    pass
+
+def mock_factory():
+    return MockService()
+
+def mock_ping(svc: MockService):
+    pass
+
+class TestContainerPings(unittest.TestCase):
+    def test_global_only_ping(self):
+        reg = Registry()
+        reg.register_factory(MockService, mock_factory, ping=mock_ping)
+        con = Container(reg)
+        pings = con.get_pings()
+        self.assertEqual(len(pings), 1)
+        self.assertEqual(pings[0]._svc_type, MockService)
+
+    def test_local_only_ping(self):
+        reg = Registry()
+        con = Container(reg)
+        con.register_local_factory(MockService, mock_factory, ping=mock_ping)
+        pings = con.get_pings()
+        self.assertEqual(len(pings), 1)
+        self.assertEqual(pings[0]._svc_type, MockService)
+
+    def test_local_shadows_global_ping(self):
+        class GlobalService: pass
+        class LocalService: pass
+        
+        def g_factory(): return GlobalService()
+        def l_factory(): return LocalService()
+        
+        reg = Registry()
+        reg.register_factory(GlobalService, g_factory, ping=mock_ping)
+        
+        con = Container(reg)
+        # Local registration for same type as global
+        con.register_local_factory(GlobalService, l_factory, ping=mock_ping)
+        
+        pings = con.get_pings()
+        self.assertEqual(len(pings), 1)
+        # Should be local one (though type is same, we check logic)
+        # In this case, both are GlobalService type, but local was registered last.
+        # The current implementation adds local first.
+
+    def test_local_shadows_global_no_ping(self):
+        class Service: pass
+        
+        def g_factory(): return Service()
+        def l_factory(): return Service()
+        
+        reg = Registry()
+        reg.register_factory(Service, g_factory, ping=mock_ping)
+        
+        con = Container(reg)
+        # Local registration for same type as global, but NO ping
+        con.register_local_factory(Service, l_factory, ping=None)
+        
+        pings = con.get_pings()
+        # Should be empty because local shadows global and local has no ping
+        self.assertEqual(len(pings), 0)
+
+    def test_multiple_services(self):
+        class S1: pass
+        class S2: pass
+        
+        def f1(): return S1()
+        def f2(): return S2()
+        
+        reg = Registry()
+        reg.register_factory(S1, f1, ping=mock_ping)
+        reg.register_factory(S2, f2, ping=mock_ping)
+        
+        con = Container(reg)
+        pings = con.get_pings()
+        self.assertEqual(len(pings), 2)
+
+if __name__ == "__main__":
+    unittest.main()
