+# SPDX-FileCopyrightText: 2023 Hynek Schlawack <hs@ox.cx>
+#
+# SPDX-License-Identifier: MIT
+
+import pytest
+from unittest.mock import Mock
+import svcs
+from svcs._core import Container, Registry, ServicePing
+
+class Service:
+    def ping(self):
+        pass
+
+class AnotherService:
+    def ping(self):
+        pass
+
+def test_get_pings_registry_only(registry, container):
+    """
+    Test that services with only a registry registration and a ping are reported.
+    """
+    ping = Mock()
+    registry.register_factory(Service, lambda: Service(), ping=ping)
+
+    pings = container.get_pings()
+    assert len(pings) == 1
+    assert pings[0]._svc_type is Service
+    assert pings[0]._ping is ping
+
+def test_get_pings_no_ping_registry_only(registry, container):
+    """
+    Test that services with only a registry registration and NO ping are NOT reported.
+    """
+    registry.register_factory(Service, lambda: Service())
+
+    pings = container.get_pings()
+    assert len(pings) == 0
+
+def test_get_pings_local_only(registry, container):
+    """
+    Test that a locally registered service with a ping is reported.
+    """
+    ping = Mock()
+    container.register_local_factory(Service, lambda: Service(), ping=ping)
+
+    pings = container.get_pings()
+    assert len(pings) == 1
+    assert pings[0]._svc_type is Service
+    assert pings[0]._ping is ping
+
+def test_get_pings_local_shadows_registry_with_ping(registry, container):
+    """
+    Test that a local registration shadowing a registry registration for the same type
+    reports the local ping.
+    """
+    registry_ping = Mock()
+    container_ping = Mock()
+
+    registry.register_factory(Service, lambda: Service(), ping=registry_ping)
+    container.register_local_factory(Service, lambda: Service(), ping=container_ping)
+
+    pings = container.get_pings()
+    assert len(pings) == 1
+    assert pings[0]._svc_type is Service
+    assert pings[0]._ping is container_ping
+
+def test_get_pings_local_shadows_registry_no_ping(registry, container):
+    """
+    Test that a local registration shadowing a registry registration for the same type
+    but having NO ping reports no ping at all.
+    """
+    registry_ping = Mock()
+
+    registry.register_factory(Service, lambda: Service(), ping=registry_ping)
+    container.register_local_factory(Service, lambda: Service(), ping=None)
+
+    pings = container.get_pings()
+    assert len(pings) == 0
+
+def test_get_pings_multiple_types(registry, container):
+    """
+    Test that pings for multiple types are correctly reported.
+    """
+    ping1 = Mock()
+    ping2 = Mock()
+
+    registry.register_factory(Service, lambda: Service(), ping=ping1)
+    registry.register_factory(AnotherService, lambda: AnotherService(), ping=ping2)
+
+    pings = container.get_pings()
+    assert len(pings) == 2
+    types = {p._svc_type for p in pings}
+    assert Service in types
+    assert AnotherService in types
+    
+    # Verify pings
+    for p in pings:
+        if p._svc_type is Service:
+            assert p._ping is ping1
+        else:
+            assert p._ping is ping2
