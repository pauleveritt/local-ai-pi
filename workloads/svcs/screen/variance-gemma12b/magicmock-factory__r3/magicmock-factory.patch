@@ -0,0 +1,11 @@
+import inspect
+from unittest.mock import MagicMock, AsyncMock
+from collections.abc import Awaitable, AbstractContextManager
+
+def isawaitable(obj):
+    return inspect.isawaitable(obj)
+
+print(f"MagicMock isawaitable: {isawaitable(MagicMock())}")
+print(f"AsyncMock isawaitable: {isawaitable(AsyncMock())}")
+print(f"MagicMock isinstance AbstractContextManager: {isinstance(MagicMock(), AbstractContextManager)}")
+print(f"AsyncMock isinstance AbstractContextManager: {isinstance(AsyncMock(), AbstractContextManager)}")
