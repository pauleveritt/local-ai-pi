@@ -129,6 +137,81 @@ class TestContainer:
 
         assert is_closed
 
+    @pytest.mark.asyncio
+    async def test_aget_enters_cms_returned_by_async_factories(
+        self, container
+    ):
+        """
+        aget enters (and exits) context managers returned by async factories,
+        whether they are synchronous or asynchronous context managers.
+        """
+        sync_is_closed = False
+        async_is_closed = False
+
+        async def sync_cm_factory():
+            await asyncio.sleep(0)
+
+            @contextmanager
+            def factory():
+                yield 42
+
+                nonlocal sync_is_closed
+                sync_is_closed = True
+
+            return factory()
+
+        async def async_cm_factory():
+            await asyncio.sleep(0)
+
+            @asynccontextmanager
+            async def factory():
+                await asyncio.sleep(0)
+                yield 43
+
+                nonlocal async_is_closed
+                async_is_closed = True
+
+            return factory()
+
+        container.registry.register_factory(int, sync_cm_factory)
+        container.registry.register_factory(str, async_cm_factory)
+
+        async with container:
+            assert 42 == await container.aget(int)
+            assert 43 == await container.aget(str)
+
+        assert sync_is_closed
+        assert async_is_closed
+
+    @pytest.mark.asyncio
+    async def test_aget_does_not_enter_cms_returned_by_async_factories_when_enter_false(
+        self, container
+    ):
+        """
+        aget does not enter context managers returned by async factories if
+        enter=False.
+        """
+        sync_entered = False
+
+        async def sync_cm_factory():
+            await asyncio.sleep(0)
+
+            @contextmanager
+            def factory():
+                nonlocal sync_entered
+                sync_entered = True
+                yield 42
+
+            return factory()
+
+        container.registry.register_factory(int, sync_cm_factory, enter=False)
+
+        async with container:
+            svc = await container.aget(int)
+
+        assert not sync_entered
+        assert isinstance(svc, AbstractContextManager)
+
 
