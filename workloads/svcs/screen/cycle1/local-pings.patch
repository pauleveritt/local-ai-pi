+def test_get_pings_includes_local(registry, container, svc):
+    """
+    get_pings reports pings of locally registered services.
+    """
+    registry.register_factory(AnotherService, AnotherService)
+    registry.register_value(Service, svc, ping=nop)
+
+    container.register_local_value(AnotherService, AnotherService(), ping=nop)
+
+    assert {Service, AnotherService} == {
+        ping._svc_type for ping in container.get_pings()
+    }
+
+
+def test_get_pings_local_shadows_registry(registry, container, svc):
+    """
+    A local registration shadows the registry registration for the same type:
+    its ping is the one reported.
+    """
+    registry.register_value(Service, svc, ping=nop)
+
+    local_ping = Mock()
+    container.register_local_value(Service, svc, ping=local_ping)
+
+    (ping,) = container.get_pings()
+
+    assert Service == ping._svc_type
+    assert local_ping is ping._ping
+
+
+def test_get_pings_local_no_ping_shadows_registry(registry, container, svc):
+    """
+    A local registration without a ping shadows a registry one with a ping:
+    no ping is reported for that type.
+    """
+    registry.register_value(Service, svc, ping=nop)
+
+    container.register_local_value(Service, svc)
+
+    assert [] == container.get_pings()
+
+    # A local registration with a ping shadows the registry's.
+    local_ping = Mock()
+    container.register_local_value(Service, svc, ping=local_ping)
+
+    (ping,) = container.get_pings()
+    assert local_ping is ping._ping
+
