+    def test_get_returns_mock_factory_result(self, container):
+        """
+        A factory that returns a MagicMock is treated as a plain value: get()
+        returns the mock without trying to enter it as a context manager or
+        registering a cleanup.
+        """
+        mock = MagicMock()
+        container.registry.register_factory(int, lambda: mock)
+
+        assert mock is container.get(int)
+
+        # The mock is cached, so subsequent calls return the same mock.
+        assert mock is container.get(int)
+
+        # No cleanup was registered for the mock.
+        assert not container._on_close
+
+        container.close()
+
+    @pytest.mark.asyncio
+    async def test_aget_returns_mock_for_async_factory(self, container):
+        """
+        An AsyncMock-based factory returns a coroutine that resolves to the
+        AsyncMock. aget() returns that mock without awaiting or entering it as
+        an async context manager.
+        """
+        mock = AsyncMock()
+        container.registry.register_factory(int, mock)
+
+        svc = await container.aget(int)
+
+        assert isinstance(svc, AsyncMock)
+        assert not container._on_close
+
+        await container.aclose()
+
+    @pytest.mark.asyncio
