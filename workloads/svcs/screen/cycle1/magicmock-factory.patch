         return repr(obj)
 
 
+def _is_mock(obj: object) -> bool:
+    """
+    Return True if *obj* is a :class:`unittest.mock.Mock`.
+
+    Mocks answer any attribute access with another mock, which means checks
+    like "does this look like a context manager?" or "is this awaitable?"
+    answer yes for a mock that is neither. Treating mocks as plain values
+    avoids attempting to enter them as context managers or awaiting them.
+    """
+    return isinstance(obj, Mock)
+
