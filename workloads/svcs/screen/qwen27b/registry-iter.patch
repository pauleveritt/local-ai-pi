@@ -281,6 +281,38 @@ class TestRegistry:
         assert Service in registry
         assert AnotherService not in registry
 
+    def test_iter_empty(self, registry):
+        """
+        Iterating over an empty registry yields nothing.
+        """
+        assert list(registry) == []
+
+    def test_iter_yields_registered_services(self, registry):
+        """
+        Iterating yields RegisteredService objects in registration order.
+        """
+        registry.register_factory(Service, Service)
+        registry.register_value(AnotherService, AnotherService())
+
+        services = list(registry)
+
+        assert len(services) == 2
+        assert services[0].svc_type is Service
+        assert services[1].svc_type is AnotherService
+
+    def test_iter_for_loop(self, registry):
+        """
+        Registry can be used in a for loop.
+        """
+        registry.register_factory(int, lambda: 1)
+        registry.register_factory(str, lambda: "hello")
+
+        types = []
+        for rs in registry:
+            types.append(rs.svc_type)
+
+        assert types == [int, str]
+
