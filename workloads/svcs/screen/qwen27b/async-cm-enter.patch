+    @pytest.mark.asyncio
+    async def test_aget_enters_sync_cm_from_async_factory(self, container):
+        """
+        aget enters a sync context manager returned by an async factory.
+        """
+        import asyncio
+
+        is_closed = False
+
+        @contextmanager
+        def cm_factory():
+            yield 42
+
+            nonlocal is_closed
+            is_closed = True
+
+        async def async_factory():
+            await asyncio.sleep(0)
+            return cm_factory()
+
+        container.registry.register_factory(int, async_factory)
+
+        async with container:
+            assert 42 == await container.aget(int)
+            assert container._on_close  # cleanup registered
+
+        assert is_closed
+
