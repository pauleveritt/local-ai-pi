+class TestAautowireContextManagers:
+    @pytest.mark.asyncio
+    async def test_async_cm_factory(self, registry, container, close_me):
+        """Async CM factories are entered and cleaned up."""
+
+        @asynccontextmanager
+        async def make_repo(db: Database):
+            await asyncio.sleep(0)
+            yield Repository(db)
+            await close_me.aclose()
+
+        registry.register_factory(Database, Database)
+        registry.register_factory(Repository, svcs.aautowire(make_repo))
+
+        repo = await container.aget(Repository)
+        assert isinstance(repo, Repository)
+        assert not close_me.is_aclosed
+        await container.aclose()
+        assert close_me.is_aclosed
+
+    @pytest.mark.asyncio
+    async def test_sync_cm_factory(self, registry, container, close_me):
+        """Sync CM factories also work with aautowire."""
+
+        @contextmanager
+        def make_repo(db: Database):
+            yield Repository(db)
+            close_me.close()
+
+        registry.register_factory(Database, Database)
+        registry.register_factory(Repository, svcs.aautowire(make_repo))
+
+        repo = await container.aget(Repository)
+        assert isinstance(repo, Repository)
+        assert not close_me.is_closed
+        await container.aclose()
+        assert close_me.is_closed
