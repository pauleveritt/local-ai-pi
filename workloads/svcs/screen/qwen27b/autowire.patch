+"""
+Tests for svcs.autowire and svcs.aautowire.
+"""
+
+import asyncio
+import dataclasses
+from contextlib import asynccontextmanager, contextmanager
+from dataclasses import InitVar
+from typing import Any
+
+import pytest
+
+import svcs
+
+from tests.helpers import CloseMe
+from tests.ifaces import AnotherService, Interface, Service, YetAnotherService
+
+
+# ---------------------------------------------------------------------------
+# Fixtures
+# ---------------------------------------------------------------------------
+
+@pytest.fixture
+def registry():
+    return svcs.Registry()
+
+
+@pytest.fixture
+def container(registry):
+    return svcs.Container(registry)
+
+
+# ---------------------------------------------------------------------------
+# Test helpers
+# ---------------------------------------------------------------------------
+
+class Database:
+    """A simple service for testing."""
+
+    def __init__(self, url: str = "sqlite://"):
+        self.url = url
+
+
+class Repository:
+    """A service that depends on Database."""
+
+    def __init__(self, db: Database):
+        self.db = db
+
+
+class Handler:
+    """A service with multiple dependencies."""
+
+    def __init__(self, repo: Repository, db: Database):
+        self.repo = repo
+        self.db = db
+
+
+class WithContainer:
+    """A service that also needs the container itself."""
+
+    def __init__(self, db: Database, container: svcs.Container):
+        self.db = db
+        self.container = container
+
+
+class WithDefault:
+    """A service with a parameter that has a default."""
+
+    def __init__(self, db: Database, name: str = "default"):
+        self.db = db
+        self.name = name
+
+
+class WithOptionalService:
+    """A service with an optional dependency (not registered)."""
+
+    def __init__(self, db: Database, cache: dict | None = None):
+        self.db = db
+        self.cache = cache
+
+
+class WithInitVar:
+    """A service using InitVar."""
+
+    def __init__(self, db: InitVar[Database], name: str):
+        self.name = name
+
+
+@dataclasses.dataclass
+class DataclassService:
+    """A dataclass service with InitVar."""
+    db: InitVar[Database]
+    name: str
+
+    def __post_init__(self, db: Database):
+        self.db_url = db.url
+
+
+# ---------------------------------------------------------------------------
+# autowire -- basic
+# ---------------------------------------------------------------------------
+
+class TestAutowireBasic:
+    def test_simple_dependency(self, registry, container):
+        """autowire resolves a single annotated dependency."""
+        registry.register_factory(Database, Database)
+        registry.register_factory(Repository, svcs.autowire(Repository))
+
+        repo = container.get(Repository)
+
+        assert isinstance(repo.db, Database)
+
+    def test_multiple_dependencies(self, registry, container):
+        """autowire resolves multiple annotated dependencies."""
+        registry.register_factory(Database, Database)
+        registry.register_factory(Repository, svcs.autowire(Repository))
+        registry.register_factory(Handler, svcs.autowire(Handler))
+
+        handler = container.get(Handler)
+
+        assert isinstance(handler.repo, Repository)
+        assert isinstance(handler.db, Database)
+
+    def test_container_annotation(self, registry, container):
+        """Parameters annotated as svcs.Container receive the container."""
+        registry.register_factory(Database, Database)
+        registry.register_factory(WithContainer, svcs.autowire(WithContainer))
+
+        svc = container.get(WithContainer)
+
+        assert isinstance(svc.db, Database)
+        assert svc.container is container
+
+    def test_default_value_used(self, registry, container):
+        """If a service is not registered and param has a default, use default."""
+        registry.register_factory(Database, Database)
+        registry.register_factory(WithDefault, svcs.autowire(WithDefault))
+
+        svc = container.get(WithDefault)
+
+        assert isinstance(svc.db, Database)
+        assert svc.name == "default"
+
+    def test_default_value_overridden(self, registry, container):
+        """If a service IS registered, the registered value is used."""
+        registry.register_factory(Database, Database)
+        registry.register_value(str, "registered")
+        registry.register_factory(WithDefault, svcs.autowire(WithDefault))
+
+        svc = container.get(WithDefault)
+
+        assert svc.name == "registered"
+
+    def test_missing_service_with_default(self, registry, container):
+        """Missing optional service uses default (None)."""
+        registry.register_factory(Database, Database)
+        registry.register_factory(
+            WithOptionalService, svcs.autowire(WithOptionalService)
+        )
+
+        svc = container.get(WithOptionalService)
+
+        assert isinstance(svc.db, Database)
+        assert svc.cache is None
+
