+# ---------------------------------------------------------------------------
+# autowire -- error cases
+# ---------------------------------------------------------------------------
+
+class TestAutowireErrors:
+    def test_no_annotation_no_default(self):
+        """Required parameter with no annotation and no default raises TypeError."""
+
+        class Bad:
+            def __init__(self, x):
+                self.x = x
+
+        with pytest.raises(TypeError, match="has no annotation and no default"):
+            svcs.autowire(Bad)
+
+    def test_bare_generator_rejected(self):
+        """Bare generator functions are rejected with TypeError."""
+
+        def bad_factory():
+            yield 42
+
+        with pytest.raises(TypeError, match="bare generator function"):
+            svcs.autowire(bad_factory)
+
+    def test_contextmanager_decorated_is_fine(self):
+        """Functions decorated with @contextmanager are accepted."""
+
+        @contextmanager
+        def good_factory():
+            yield 42
+
+        # Should not raise
+        factory = svcs.autowire(good_factory)
+
+        registry = svcs.Registry()
+        registry.register_factory(int, factory)
+        with svcs.Container(registry) as con:
+            assert 42 == con.get(int)
+
+    def test_missing_required_service_raises(self, registry, container):
+        """Missing required service raises ServiceNotFoundError."""
+        registry.register_factory(Repository, svcs.autowire(Repository))
+
+        with pytest.raises(svcs.exceptions.ServiceNotFoundError):
+            container.get(Repository)
+
+
+# ---------------------------------------------------------------------------
+# autowire -- variadic and edge cases
+# ---------------------------------------------------------------------------
+
+class TestAutowireEdgeCases:
+    def test_variadic_ignored(self, registry, container):
+        """*args and **kwargs are ignored."""
+
+        class WithVariadic:
+            def __init__(self, db: Database, *args, **kwargs):
+                self.db = db
+                self.args = args
+                self.kwargs = kwargs
+
+        registry.register_factory(Database, Database)
+        registry.register_factory(
+            WithVariadic, svcs.autowire(WithVariadic)
+        )
+
+        svc = container.get(WithVariadic)
+
+        assert isinstance(svc.db, Database)
+        assert svc.args == ()
+        assert svc.kwargs == {}
+
+    def test_unannotated_with_default_ignored(self, registry, container):
+        """Unannotated parameters with defaults are ignored (not passed)."""
+
+        class Mixed:
+            def __init__(self, db: Database, extra: str = "hello"):
+                self.db = db
+                self.extra = extra
+
+        registry.register_factory(Database, Database)
+        registry.register_factory(Mixed, svcs.autowire(Mixed))
+
+        svc = container.get(Mixed)
+
+        assert isinstance(svc.db, Database)
+        assert svc.extra == "hello"
+
+    def test_initvar_unwrapped(self, registry, container):
+        """InitVar annotations are unwrapped to the inner type."""
+        registry.register_factory(Database, Database)
+
+        # Function that takes InitVar[Database] -- should resolve as Database
+        def make_with_initvar(db: InitVar[Database]) -> WithInitVar:
+            return WithInitVar(db, "from_initvar")
+
+        registry.register_factory(
+            WithInitVar, svcs.autowire(make_with_initvar)
+        )
+
+        svc = container.get(WithInitVar)
+        assert svc.name == "from_initvar"
+
+
+# ---------------------------------------------------------------------------
+# autowire -- string annotations
+# ---------------------------------------------------------------------------
+
+class TestAutowireStringAnnotations:
+    def test_string_annotation_resolved(self, registry, container):
+        """String annotations are resolved at factory runtime."""
+
+        class StringDep:
+            def __init__(self, db: "Database"):
+                self.db = db
+
+        registry.register_factory(Database, Database)
+        registry.register_factory(StringDep, svcs.autowire(StringDep))
+
+        svc = container.get(StringDep)
+        assert isinstance(svc.db, Database)
+
+    def test_forward_reference(self, registry, container):
+        """Forward references work even if defined before the type."""
+
+        class ForwardDep:
+            def __init__(self, repo: "Repository"):
+                self.repo = repo
+
+        registry.register_factory(Database, Database)
+        registry.register_factory(Repository, svcs.autowire(Repository))
+        registry.register_factory(ForwardDep, svcs.autowire(ForwardDep))
+
+        svc = container.get(ForwardDep)
+        assert isinstance(svc.repo, Repository)
+
+    def test_string_container_annotation(self, registry, container):
+        """String 'Container' annotation resolves to the container."""
+
+        class StringContainer:
+            def __init__(self, con: "Container"):
+                self.con = con
+
+        registry.register_factory(StringContainer, svcs.autowire(StringContainer))
+
+        svc = container.get(StringContainer)
+        assert svc.con is container
+
