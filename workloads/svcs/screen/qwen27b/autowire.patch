+        repo = await container.aget(Repository)
+        assert repo.db.url == "async://"
+        await container.aclose()
+
+    @pytest.mark.asyncio
+    async def test_awaits_result(self, registry, container):
+        """aautowire awaits the result if fn_or_cls returns an awaitable."""
+
+        async def async_handler(repo: Repository, db: Database) -> Handler:
+            await asyncio.sleep(0)
+            return Handler(repo, db)
+
+        registry.register_factory(Database, Database)
+        registry.register_factory(Repository, svcs.autowire(Repository))
+        registry.register_factory(
+            Handler, svcs.aautowire(async_handler)
+        )
+
+        handler = await container.aget(Handler)
+        assert isinstance(handler, Handler)
+        await container.aclose()
+
