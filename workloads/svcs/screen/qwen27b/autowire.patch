+def _unwrap_initvar(annotation: Any) -> Any:
+    """
+    Unwrap ``dataclasses.InitVar[T]`` to ``T``.
+
+    Handles both ``InitVar[T]`` and bare ``InitVar`` (which resolves to
+    ``InitVar[Any]``).
+    """
+    # InitVar[T] creates an instance with a .type attribute
+    if (
+        type(annotation).__module__ == "dataclasses"
+        and type(annotation).__name__ == "InitVar"
+    ):
+        inner = getattr(annotation, "type", None)
+        if inner is not None:
+            return inner
+        return Any
+    return annotation
+
+
+def _resolve_annotation(
+    annotation: Any,
+    globalns: dict[str, Any] | None,
+    localns: dict[str, Any] | None,
+) -> Any:
+    """
+    Resolve a string annotation to the actual type object.
+
+    If *annotation* is already a type, return it unchanged.
+    """
+    if isinstance(annotation, str):
+        if globalns is None:
+            globalns = {}
+        # Ensure Container is available for resolution
+        globalns = {"Container": Container, **globalns}
+        try:
+            return eval(annotation, globalns, localns)  # noqa: S307
+        except NameError:
+            return annotation
+    return annotation
+
+
+def _collect_params(
+    fn_or_cls: Callable,
+) -> list[tuple[str, Any, Parameter]]:
+    """
+    Collect parameters from *fn_or_cls* that should be autowired.
+
+    Returns a list of ``(name, annotation, parameter)`` tuples for parameters
+    that have annotations (excluding ``*args``, ``**kwargs``, and
+    ``svcs.Container`` which is handled specially).
+
+    Raises ``TypeError`` for required parameters without annotation or default.
+    """
+    sig = signature(fn_or_cls)
+
+    # Get globals for string annotation resolution.
+    # For classes, the __init__ method holds the globals.
+    if inspect.isclass(fn_or_cls):
+        globalns: dict[str, Any] | None = getattr(
+            fn_or_cls.__init__, "__globals__", None
+        )
+    else:
+        globalns = getattr(fn_or_cls, "__globals__", None)
+
+    result: list[tuple[str, Any, Parameter]] = []
+
+    for name, param in sig.parameters.items():
+        # Skip variadic parameters
+        if param.kind in (
+            Parameter.VAR_POSITIONAL,
+            Parameter.VAR_KEYWORD,
+        ):
+            continue
+
+        annotation = param.annotation
+
+        if annotation is Parameter.empty:
+            # No annotation
+            if param.default is Parameter.empty:
+                # Required parameter with no annotation -- error
+                raise TypeError(
+                    f"parameter {name!r} of {_full_name(fn_or_cls)} "
+                    f"has no annotation and no default"
+                )
+            # Has a default but no annotation -- skip it
+            continue
+
+        # Unwrap InitVar
+        annotation = _unwrap_initvar(annotation)
+
+        # Resolve string annotations
+        annotation = _resolve_annotation(annotation, globalns, None)
+
+        result.append((name, annotation, param))
+
+    return result
+
+
+def _resolve_service_sync(
+    container: Container,
+    annotation: Any,
+    param: Parameter,
+) -> Any:
+    """
+    Resolve a single service from *container* by *annotation*.
+
+    If the service is not registered and the parameter has a default, return
+    the default. Otherwise raise ``ServiceNotFoundError``.
+
+    If the service IS registered but its factory raises an error, that error
+    propagates (is not masked by the default).
+    """
+    # Check if the service is registered BEFORE trying to get it.
+    # This lets us distinguish "not registered" from "registered but factory
+    # failed".
+    if annotation not in container.registry:
+        if param.default is not Parameter.empty:
+            return param.default
+        raise ServiceNotFoundError(annotation)
+
+    # Service is registered -- get it and let any errors propagate
+    return container.get(annotation)
+
+
+def autowire(fn_or_cls: Callable) -> Callable:
+    """
+    Create a factory that auto-resolves annotated dependencies from a
+    :class:`svcs.Container`.
+
+    Returns a callable that takes a :class:`svcs.Container`, resolves each of
+    ``fn_or_cls``'s annotated parameters from that container, and calls
+    ``fn_or_cls`` with the resolved services.
+
+    Parameters annotated as :class:`svcs.Container` receive the container
+    itself.  Parameters with a default value that are not registered in the
+    container use their default instead of raising.
+
+    Variadic parameters (``*args``, ``**kwargs``) are ignored.
+
+    ``dataclasses.InitVar`` annotations are unwrapped to the type they wrap.
+
+    String annotations (forward references) are resolved at factory runtime.
+
+    Raises:
+        TypeError:
+            If ``fn_or_cls`` is a bare generator function, or if a required
+            parameter has neither an annotation nor a default value.
+
+    Example:
+
+        >>> class Database:
+        ...     pass
+        >>> class Repository:
+        ...     def __init__(self, db: Database):
+        ...         self.db = db
+        >>> registry.register_factory(Repository, svcs.autowire(Repository))
+
+    .. versionadded:: 26.2.0
+    """
+    # Reject bare generator functions
+    if isgeneratorfunction(fn_or_cls):
+        raise TypeError(
+            f"{_full_name(fn_or_cls)} is a bare generator function; "
+            "its cleanup would be silently lost. "
+            "Use @contextmanager instead."
+        )
+
+    params = _collect_params(fn_or_cls)
+
+    def factory(svcs_container: Container) -> Any:
+        kwargs: dict[str, Any] = {}
+        for name, annotation, param in params:
+            if annotation is Container:
+                kwargs[name] = svcs_container
+            else:
+                kwargs[name] = _resolve_service_sync(
+                    svcs_container, annotation, param
+                )
+        return fn_or_cls(**kwargs)
+
+    return factory
+
+
+async def _resolve_service_async_full(
+    container: Container,
+    annotation: Any,
+    param: Parameter,
+) -> Any:
+    """
+    Resolve a single service from *container* by *annotation* using async
+    lookup (``aget``).
+
+    If the service is not registered and the parameter has a default, return
+    the default. Otherwise raise ``ServiceNotFoundError``.
+
+    If the service IS registered but its factory raises an error, that error
+    propagates (is not masked by the default).
+    """
+    # Check if the service is registered BEFORE trying to get it.
+    if annotation not in container.registry:
+        if param.default is not Parameter.empty:
+            return param.default
+        raise ServiceNotFoundError(annotation)
+
+    # Service is registered -- get it and let any errors propagate
+    return await container.aget(annotation)
+
+
+def aautowire(fn_or_cls: Callable) -> Callable:
+    """
+    Async version of :func:`autowire`.
+
+    Returns an async factory that resolves services through the container's
+    asynchronous lookup and awaits the result of ``fn_or_cls`` when that result
+    is awaitable.
+
+    Works with both synchronous and asynchronous callables and services.
+
+    Raises:
+        TypeError:
+            If ``fn_or_cls`` is a bare async generator function, or if a
+            required parameter has neither an annotation nor a default value.
+
+    .. versionadded:: 26.2.0
+    """
+    # Reject bare async generator functions
+    if isasyncgenfunction(fn_or_cls):
+        raise TypeError(
+            f"{_full_name(fn_or_cls)} is a bare async generator function; "
+            "its cleanup would be silently lost. "
+            "Use @asynccontextmanager instead."
+        )
+
+    params = _collect_params(fn_or_cls)
+
+    async def factory(svcs_container: Container) -> Any:
+        kwargs: dict[str, Any] = {}
+        for name, annotation, param in params:
+            if annotation is Container:
+                kwargs[name] = svcs_container
+            else:
+                kwargs[name] = await _resolve_service_async_full(
+                    svcs_container, annotation, param
+                )
+        result = fn_or_cls(**kwargs)
+        if isawaitable(result):
+            result = await result
+        return result
+
+    return factory
+
+
