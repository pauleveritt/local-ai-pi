+
+    @pytest.mark.asyncio
+    async def test_async_factory(self, registry, container):
+        """aautowire works with async factories."""
+
+        async def async_db_factory():
+            await asyncio.sleep(0)
+            return Database("async://")
+
+        registry.register_factory(Database, async_db_factory)
+        registry.register_factory(Repository, svcs.aautowire(Repository))
