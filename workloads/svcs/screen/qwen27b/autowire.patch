+# ---------------------------------------------------------------------------
+# autowire -- context manager factories
+# ---------------------------------------------------------------------------
+
+class TestAutowireContextManagers:
+    def test_cm_factory_entered(self, registry, container, close_me):
+        """Factories returning context managers are entered/cleaned up."""
+
+        @contextmanager
+        def factory(db: Database):
+            yield db
+            close_me.close()
+
+        registry.register_factory(Database, Database)
+        registry.register_factory(Repository, svcs.autowire(factory))
+
+        # The autowired factory wraps the CM
+        svc = container.get(Repository)
+        assert isinstance(svc, Database)
+        assert not close_me.is_closed
+        container.close()
+        assert close_me.is_closed
+
+    def test_class_with_cm_factory(self, registry, container, close_me):
+        """A class registered via autowire with a CM factory works."""
+
+        @contextmanager
+        def make_repo(db: Database):
+            yield Repository(db)
+            close_me.close()
+
+        registry.register_factory(Database, Database)
+        registry.register_factory(Repository, svcs.autowire(make_repo))
+
+        repo = container.get(Repository)
+        assert isinstance(repo, Repository)
+        assert not close_me.is_closed
+        container.close()
+        assert close_me.is_closed
+
