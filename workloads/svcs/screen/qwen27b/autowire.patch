+
+class TestAutowireFutureAnnotations:
+    """Test that autowire works with from __future__ import annotations."""
+
+    def test_future_annotations(self, registry, container):
+        """All annotations are strings with future annotations, still works."""
+        # Import a module that uses from __future__ import annotations
+        import importlib.util
+        import tempfile
+        import os
+
+        code = '''
+from __future__ import annotations
+import svcs
+
+class FutureDep:
+    def __init__(self, db: Database):
+        self.db = db
+'''
+        with tempfile.TemporaryDirectory() as tmpdir:
+            mod_path = os.path.join(tmpdir, "future_mod.py")
+            with open(mod_path, "w") as f:
+                f.write(code)
+
+            spec = importlib.util.spec_from_file_location(
+                "future_mod", mod_path
+            )
+            mod = importlib.util.module_from_spec(spec)
+            # Inject Database into the module's namespace
+            mod.Database = Database
+            spec.loader.exec_module(mod)
+
+            registry.register_factory(Database, Database)
+            registry.register_factory(
+                mod.FutureDep, svcs.autowire(mod.FutureDep)
+            )
+
+            svc = container.get(mod.FutureDep)
+            assert isinstance(svc.db, Database)
+
+    def test_svcs_container_string_annotation(self, registry, container):
+        """String 'svcs.Container' annotation also resolves to the container."""
