+    def test_get_magicmock(self, container):
+        """
+        A factory that returns a MagicMock is returned as-is without
+        attempting to enter it as a context manager.
+        """
+        mock = MagicMock()
+        container.registry.register_factory(Service, lambda: mock)
+
+        result = container.get(Service)
+
+        assert result is mock
+        assert not container._on_close
+
+    @pytest.mark.asyncio
+    async def test_aget_asyncmock(self, container):
+        """
+        A factory that returns an AsyncMock is returned as-is without
+        attempting to await it or enter it as an async context manager.
+        """
+        async_mock = AsyncMock()
+        container.registry.register_factory(Service, lambda: async_mock)
+
+        result = await container.aget(Service)
+
+        assert result is async_mock
+        assert not container._on_close
+
+    @pytest.mark.asyncio
+    async def test_aget_magicmock(self, container):
+        """
+        A factory that returns a MagicMock works with aget() as well.
+        """
+        mock = MagicMock()
+        container.registry.register_factory(Service, lambda: mock)
+
+        result = await container.aget(Service)
+
+        assert result is mock
+        assert not container._on_close
+
 
