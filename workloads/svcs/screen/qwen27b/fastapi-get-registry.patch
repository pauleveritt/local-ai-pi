+def get_registry(app: FastAPI) -> svcs.Registry:
+    """
+    Get the :class:`svcs.Registry` from a running FastAPI application.
+
+    This allows access to the registry outside of a request context, for
+    example in tests, scripts, or startup hooks.
+
+    Args:
+        app: The FastAPI application (or a :class:`fastapi.testclient.TestClient`
+            that wraps one).
+
+    Returns:
+        The :class:`svcs.Registry` attached to the application's lifespan.
+
+    Raises:
+        RegistryNotAvailable:
+            If the application has no registry attached. This happens if the
+            application has not been started yet, has already been shut down,
+            or was never configured with :class:`svcs.fastapi.lifespan`.
+
+    Example:
+        >>> from fastapi import FastAPI
+        >>> from fastapi.testclient import TestClient
+        >>> app = FastAPI(lifespan=svcs.fastapi.lifespan(my_lifespan))
+        >>> with TestClient(app) as client:
+        ...     registry = svcs.fastapi.get_registry(client)
+        ...     # use registry to register services or inspect state
+    """
+    # Handle TestClient by extracting the wrapped app
+    from starlette.testclient import TestClient
+
+    if isinstance(app, TestClient):
+        app = app.app
+
+    # The lifespan context is stored on the router
+    lifespan_context = getattr(app.router, "lifespan_context", None)
+    if not isinstance(lifespan_context, lifespan):
+        raise RegistryNotAvailable(
+            "No svcs.Registry is attached to this application. "
+            "This can happen if the application has not been started, "
+            "has already been shut down, or was not configured with "
+            "svcs.fastapi.lifespan."
+        )
+
+    registry = lifespan_context._state.get(_KEY_REGISTRY)
+    if registry is None:
+        raise RegistryNotAvailable(
+            "No svcs.Registry is attached to this application. "
+            "This can happen if the application has not been started, "
+            "has already been shut down, or was not configured with "
+            "svcs.fastapi.lifespan."
+        )
+    return registry  # type: ignore[no-any-return]
 
 
