+class RegistryNotAvailable(Exception):
+    """
+    Raised when :func:`svcs.starlette.get_registry` or
+    :func:`svcs.fastapi.get_registry` is called on an application that has no
+    registry attached.
+
+    This happens if the application has not been started yet, has already been
+    shut down, or was never configured with a *svcs* lifespan.
+    """
