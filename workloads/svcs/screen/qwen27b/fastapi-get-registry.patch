+@pytest.mark.asyncio
+async def test_get_registry_returns_same_object_as_request():
+    """
+    get_registry returns the same registry object that request-scoped code
+    receives.
+    """
+    captured_registry: svcs.Registry | None = None
+
+    @svcs.fastapi.lifespan
+    async def lifespan(app: FastAPI, registry: svcs.Registry):
+        nonlocal captured_registry
+        captured_registry = registry
+        registry.register_value(int, 42)
+        yield
+
+    app = FastAPI(lifespan=lifespan)
+
+    @app.get("/")
+    async def view(services: svcs.fastapi.DepContainer):
+        return {"ok": True}
+
+    with TestClient(app) as client:
+        # get_registry via TestClient returns same object
+        reg = svcs.fastapi.get_registry(client)
+        assert reg is captured_registry
+        # Also works with the app directly
+        assert svcs.fastapi.get_registry(app) is reg
+
+
+@pytest.mark.asyncio
+async def test_get_registry_works_with_app_directly():
+    """
+    get_registry works when given the application directly, not a test client.
+    """
+
+    @svcs.fastapi.lifespan
+    async def lifespan(app: FastAPI, registry: svcs.Registry):
+        registry.register_value(str, "hello")
+        yield
+
+    app = FastAPI(lifespan=lifespan)
+
+    with TestClient(app):
+        reg = svcs.fastapi.get_registry(app)
+        assert isinstance(reg, svcs.Registry)
+        assert str in reg
+
+
+@pytest.mark.asyncio
+async def test_get_registry_raises_before_startup():
+    """
+    get_registry raises RegistryNotAvailable when called before the app
+    has started.
+    """
+
+    @svcs.fastapi.lifespan
+    async def lifespan(app: FastAPI, registry: svcs.Registry):
+        yield
+
+    app = FastAPI(lifespan=lifespan)
+
+    with pytest.raises(
+        svcs.exceptions.RegistryNotAvailable,
+        match="No svcs.Registry is attached",
+    ):
+        svcs.fastapi.get_registry(app)
+
+
+@pytest.mark.asyncio
+async def test_get_registry_raises_after_shutdown():
+    """
+    get_registry raises RegistryNotAvailable once the application has shut
+    down.
+    """
+
+    @svcs.fastapi.lifespan
+    async def lifespan(app: FastAPI, registry: svcs.Registry):
+        registry.register_value(int, 42)
+        yield
+
+    app = FastAPI(lifespan=lifespan)
+
+    with TestClient(app):
+        reg = svcs.fastapi.get_registry(app)
+        assert isinstance(reg, svcs.Registry)
+
+    # After shutdown, registry is no longer available
+    with pytest.raises(
+        svcs.exceptions.RegistryNotAvailable,
+        match="No svcs.Registry is attached",
+    ):
+        svcs.fastapi.get_registry(app)
+
+
+@pytest.mark.asyncio
+async def test_get_registry_raises_without_svcs_lifespan():
+    """
+    get_registry raises RegistryNotAvailable when the app was never
+    configured with a svcs lifespan.
+    """
+
+    app = FastAPI()
+
+    @app.get("/")
+    async def view():
+        return {"ok": True}
+
+    with pytest.raises(
+        svcs.exceptions.RegistryNotAvailable,
+        match="No svcs.Registry is attached",
+    ):
+        with TestClient(app) as client:
+            svcs.fastapi.get_registry(client)
