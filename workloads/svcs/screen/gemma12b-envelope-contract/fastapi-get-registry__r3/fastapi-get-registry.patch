+def get_registry(app_or_client: Starlette | TestClient) -> svcs.Registry:
+    """
+    Retrieve the svcs registry from a Starlette application or a TestClient.
+
+    Raises:
+        RuntimeError: If the application does not have a svcs lifespan attached,
+            or if the application has already shut down.
+    """
+    app = app_or_client.app if isinstance(app_or_client, TestClient) else app_or_client
+
+    # Starlette stores lifespan on app._lifespan.
+    # However, it might be wrapped by starlette's own lifespan handling.
+    # We need to find the svcs.starlette.lifespan instance.
+    lifespan_instance = getattr(app, "_lifespan", None)
+
+    # If it's wrapped, we might need to dig.
+    # In starlette, the wrapper is usually an instance of starlette.applications.Lifespan.
+    # But wait, the requirement says "navigate this wrapping".
+    # Let's see how starlette wraps it.
+    # Actually, we can just check if the attribute exists and if it's our class.
+    # If it's not, we check if it's a wrapper that contains our class.
+    # But the most common case is that the user passed svcs.starlette.lifespan(app).
+    # And Starlette might have stored that directly.
+
+    # If it's a Starlette-wrapped lifespan, it will have a 'lifespan' attribute
+    # which is our actual lifespan instance.
+    if not isinstance(lifespan_instance, lifespan):
+        if hasattr(lifespan_instance, "lifespan"):
+            lifespan_instance = lifespan_instance.lifespan
+        else:
+            raise RuntimeError("Application does not have a svcs-aware lifespan attached.")
+
+    if lifespan_instance.registry.is_closed:
+        raise RuntimeError("The application has shut down.")
+
+    return lifespan_instance.registry
