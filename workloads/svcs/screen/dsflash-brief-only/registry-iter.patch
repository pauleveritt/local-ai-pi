+
+        registry.register_factory(Service, Service)
+        registry.register_factory(AnotherService, AnotherService)
+
+        services = list(registry)
+
+        assert [Service, AnotherService] == [s.svc_type for s in services]
+
+        # The yielded objects are the very same ones the registry stores.
+        assert services == [
