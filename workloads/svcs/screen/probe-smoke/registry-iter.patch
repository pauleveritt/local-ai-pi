+    def test_iter_empty(self, registry):
+        """
+        Iterating an empty registry yields nothing.
+        """
+        assert [] == list(registry)
+
+    def test_iter(self, registry):
+        """
+        Iterating yields the registered services.
+        """
+        registry.register_factory(Service, Service)
+        registry.register_value(AnotherService, AnotherService)
+
+        services = list(registry)
+
+        assert Service == services[0].svc_type
+        assert AnotherService == services[1].svc_type
+
+        # The yielded objects are the same ones the registry stores.
+        assert services == list(registry._services.values())
+
+    def test_iter_after_close(self, registry):
+        """
+        Iterating after close yields nothing.
+        """
+        registry.register_factory(Service, Service)
+        registry.close()
+
+        assert [] == list(registry)
+
