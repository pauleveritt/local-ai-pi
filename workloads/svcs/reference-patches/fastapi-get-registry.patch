+def test_get_registry_composed_lifespans():
+    """
+    With composed svcs lifespans, the first one wins and detaches the
+    registry on shutdown.
+    """
+
+    @svcs.starlette.lifespan
+    async def first(app: Starlette, registry: svcs.Registry):
